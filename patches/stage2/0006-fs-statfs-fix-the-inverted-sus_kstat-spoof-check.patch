From 2fa0c3ad34e00f126e1b4c622c1874b29c5c94d5 Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Thu, 1 Oct 2026 00:41:50 +0000
Subject: [PATCH] fs: statfs: fix the inverted sus_kstat spoof check

susfs_sus_kstat_spoof_vfs_statfs() returns 0 after filling buf, but
susfs_statfs_by_dentry() treated nonzero as success: a matching entry
was overwritten by the real statfs and a miss returned a zeroed buffer.
Match upstream 38b8d14/b1de873: keep buf on 0, otherwise do the real
statfs and set f_flags from the mount. Add statfs_by_dentry_wrapper()
and calculate_f_flags_wrapper() for susfs.c.
---
 fs/statfs.c | 35 ++++++++++++++++++++++++++---------
 1 file changed, 26 insertions(+), 9 deletions(-)

diff --git a/fs/statfs.c b/fs/statfs.c
index d4cc8c2b90a..59297e6ab1f 100644
--- a/fs/statfs.c
+++ b/fs/statfs.c
@@ -75,7 +75,17 @@ extern struct vfsmount *susfs_get_non_sus_vfsmnt_from_vfsmnt(struct vfsmount *vf
 #endif // #ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
 
 #ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
-static int susfs_statfs_by_dentry(struct dentry *dentry, struct kstatfs *buf, bool *is_fuse)
+int statfs_by_dentry_wrapper(struct dentry *dentry, struct kstatfs *buf)
+{
+	return statfs_by_dentry(dentry, buf);
+}
+
+int calculate_f_flags_wrapper(struct vfsmount *mnt)
+{
+	return calculate_f_flags(mnt);
+}
+
+static int susfs_statfs_by_dentry(struct dentry *dentry, struct vfsmount *mnt, struct kstatfs *buf, bool *is_fuse)
 {
 	int retval;
 
@@ -86,12 +96,19 @@ static int susfs_statfs_by_dentry(struct dentry *dentry, struct kstatfs *buf, bo
 	retval = security_sb_statfs(dentry);
 	if (retval)
 		return retval;
-	if (susfs_sus_kstat_spoof_vfs_statfs(d_backing_inode(dentry), buf, is_fuse))
-		goto bypass_orig_flow;
+	// - susfs_sus_kstat_spoof_vfs_statfs() returns 0 when it filled buf
+	//   from the stored entry, f_flags included.
+	if (!susfs_sus_kstat_spoof_vfs_statfs(d_backing_inode(dentry), buf, is_fuse)) {
+		if (buf->f_frsize == 0)
+			buf->f_frsize = buf->f_bsize;
+		return retval;
+	}
 	retval = dentry->d_sb->s_op->statfs(dentry, buf);
-bypass_orig_flow:
-	if (retval == 0 && buf->f_frsize == 0)
-		buf->f_frsize = buf->f_bsize;
+	if (retval == 0) {
+		buf->f_flags = calculate_f_flags(mnt);
+		if (buf->f_frsize == 0)
+			buf->f_frsize = buf->f_bsize;
+	}
 	return retval;
 }
 #endif // #ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
@@ -105,9 +122,9 @@ int vfs_statfs(struct path *path, struct kstatfs *buf)
 		struct inode *inode = d_backing_inode(path->dentry);
 		bool is_fuse = false;
 		if (susfs_is_inode_sus_kstat(inode, &is_fuse)) {
-			// - here we do not call calculate_f_flags() as buf->f_flags will be spoofed
-			//   by susfs_statfs_by_dentry().
-			return susfs_statfs_by_dentry(path->dentry, buf, &is_fuse);
+			// - buf->f_flags on the sus_kstat path is handled by
+			//   susfs_statfs_by_dentry().
+			return susfs_statfs_by_dentry(path->dentry, path->mnt, buf, &is_fuse);
 		}
 	}
 #endif // #ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
