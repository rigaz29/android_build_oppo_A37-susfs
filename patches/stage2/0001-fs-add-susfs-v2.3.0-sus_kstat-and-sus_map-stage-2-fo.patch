 	memset(&mss, 0, sizeof mss);
 	mss.vma = vma;
+
+#ifdef CONFIG_KSU_SUSFS_SUS_MAP
+	if (vma->vm_file && SUSFS_IS_INODE_SUS_MAP(file_inode(vma->vm_file)))
+		return 0;
+#endif // #ifdef CONFIG_KSU_SUSFS_SUS_MAP
+
