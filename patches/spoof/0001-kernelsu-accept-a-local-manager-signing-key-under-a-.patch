From d6dfb4ec3696bc9581fa24e644d87c9241cb250b Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Tue, 6 Oct 2026 12:51:03 +0000
Subject: [PATCH] kernelsu: accept a local manager signing key under a spoofed
 package

Add our own signing cert to is_manager_apk (not package-locked) and point
KSU_PACKAGE_NAME at the spoofed applicationId. Since 32664 throne_tracker only
signature-checks a dir whose package == KSU_PACKAGE_NAME, the random package
must be set here too or the manager is never crowned. Keep KSU_PACKAGE_NAME in
sync with work/ksu-manager-key/package-name.txt.
---
 drivers/kernelsu/Makefile           | 6 +++++-
 drivers/kernelsu/manager/apk_sign.c | 5 +++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/kernelsu/Makefile b/drivers/kernelsu/Makefile
index 247e082..a3341cb 100644
--- a/drivers/kernelsu/Makefile
+++ b/drivers/kernelsu/Makefile
@@ -14,7 +14,11 @@ $(info -- MDIR: $(MDIR))
 # compliant to last upstream kernel change as of 6b5f55b
 CFLAGS_ksu.o += -DKSU_VERSION=32664
 
-KSU_PACKAGE_NAME := me.weishu.kernelsu
+# A37 spoofed build: 32664's throne_tracker only signature-checks a dir whose
+# package name equals KSU_PACKAGE_NAME (or kowx712), so our random applicationId
+# must be set here or the manager is never crowned. is_manager_apk still gates by
+# our own cert. Keep this in sync with work/ksu-manager-key/package-name.txt.
+KSU_PACKAGE_NAME := kkotwy.xjkmck.tlevjp
 KSU_EXPECTED_SIZE := 0x033b
 KSU_EXPECTED_HASH := c371061b19d8c7d7d6133c6a9bafe198fa944e50c1b31c9d8daa8d7f1fc2d2d6
 
diff --git a/drivers/kernelsu/manager/apk_sign.c b/drivers/kernelsu/manager/apk_sign.c
index 6dea41d..0acf075 100644
--- a/drivers/kernelsu/manager/apk_sign.c
+++ b/drivers/kernelsu/manager/apk_sign.c
@@ -339,5 +339,10 @@ bool is_manager_apk(char *path)
 	if (check_v2_signature(path, 0x375, "484fcba6e6c43b1fb09700633bf2fb4758f13cb0b2f4457b80d075084b26c588"))
 		return true;
 
+	// A37 local manager key, not package-locked so the manager may be
+	// built under any applicationId (spoofed build)
+	if (check_v2_signature(path, 0x339, "9220865a436ffcf2bdc984bcbf0e71135e21334e2a7936cee36337af1e67d0f5"))
+		return true;
+
 	return false;
 }
-- 
2.43.0

