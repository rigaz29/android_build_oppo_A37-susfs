From beac53cd975dfe9f0509b18c41b6d52c63a8323f Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Wed, 23 Sep 2026 13:24:52 +0000
Subject: [PATCH 2/2] kernelsu: wire susfs stage 1 (sus_mount) into the reboot
 supercall

Handle CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS from root callers so
ksu_susfs hide_sus_mnts_for_non_su_procs works. Expose
CONFIG_KSU_SUSFS_SUS_MOUNT and enable it in lineageos_a37f_defconfig.
---
 arch/arm64/configs/lineageos_a37f_defconfig |  3 ++-
 drivers/kernelsu/Kconfig                    | 11 ++++++++++-
 drivers/kernelsu/supercall/supercall.c      |  5 +++++
 3 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/lineageos_a37f_defconfig b/arch/arm64/configs/lineageos_a37f_defconfig
index d914727a85a..f8e798ef700 100644
--- a/arch/arm64/configs/lineageos_a37f_defconfig
+++ b/arch/arm64/configs/lineageos_a37f_defconfig
@@ -883,8 +883,9 @@ CONFIG_KSU=y
 # CONFIG_KSU_HACK_ARM64_BRANCH_LINK is not set
 CONFIG_KSU_TAMPER_SYSCALL_TABLE=y
 CONFIG_KSU_LSM_SECURITY_HOOKS=y
-# SUSFS (stage 0: core + uname/cmdline spoof + log)
+# SUSFS (stage 0: core + uname/cmdline spoof + log; stage 1: sus_mount)
 CONFIG_KSU_SUSFS=y
 CONFIG_KSU_SUSFS_SPOOF_UNAME=y
 CONFIG_KSU_SUSFS_ENABLE_LOG=y
 CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
+CONFIG_KSU_SUSFS_SUS_MOUNT=y
diff --git a/drivers/kernelsu/Kconfig b/drivers/kernelsu/Kconfig
index bd1ad539d10..790f7d5e66d 100644
--- a/drivers/kernelsu/Kconfig
+++ b/drivers/kernelsu/Kconfig
@@ -134,7 +134,7 @@ endmenu
 
 menu "KernelSU - SUSFS"
 # Only the features already ported to this 3.10 tree are exposed here. The
-# rest (sus_path, sus_mount, sus_kstat, sus_map, open_redirect, symbol hiding)
+# rest (sus_path, sus_kstat, sus_map, open_redirect, symbol hiding)
 # need VFS hooks that are not in yet; they get their option when ported.
 
 config KSU_SUSFS
@@ -165,4 +165,13 @@ config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
 	help
 	  Spoof the output of /proc/cmdline.
 
+config KSU_SUSFS_SUS_MOUNT
+	bool "Enable to hide sus mounts"
+	depends on KSU_SUSFS
+	default y
+	help
+	  Hide mounts created by su domain processes from /proc/mounts,
+	  /proc/<pid>/mountinfo and /proc/<pid>/mountstats for non-su
+	  processes. Can be toggled at runtime with ksu_susfs.
+
 endmenu
diff --git a/drivers/kernelsu/supercall/supercall.c b/drivers/kernelsu/supercall/supercall.c
index ecbe50e8fe9..2d9064c5768 100644
--- a/drivers/kernelsu/supercall/supercall.c
+++ b/drivers/kernelsu/supercall/supercall.c
@@ -129,6 +129,11 @@ int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd, void __user
 		case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
 			susfs_set_cmdline_or_bootconfig(arg);
 			return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+		case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+			susfs_set_hide_sus_mnts_for_non_su_procs(arg);
+			return 0;
 #endif
 		case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
 			susfs_set_avc_log_spoofing(arg);
-- 
